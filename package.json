{
  "name": "ai-toolbox",
  "version": "1.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --config chrome-extension/vitest.config.js",
    "test:watch": "vitest --config chrome-extension/vitest.config.js",
    "test:coverage": "vitest run --config chrome-extension/vitest.config.js --coverage",
    "test:ui": "vitest --config chrome-extension/vitest.config.js --ui",
    "test:integration": "vitest run --config chrome-extension/vitest.config.js tests/integration",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint chrome-extension/**/*.js",
    "lint:css": "stylelint chrome-extension/**/*.css",
    "lint:html": "htmlhint chrome-extension/sidepanel/*.html chrome-extension/settings/*.html",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanZdanovich/ai-toolbox.git"
  },
  "keywords": [],
  "author": "Ivan Zdanovich",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/IvanZdanovich/ai-toolbox/issues"
  },
  "homepage": "https://github.com/IvanZdanovich/ai-toolbox#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "htmlhint": "^1.9.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^5.0.0"
  }
}
